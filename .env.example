# Supabase Config
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-or-service-role-key

# Router Config
PORT=8000
# Optional: Bearer token to protect this router itself from public access
ROUTER_API_KEY=your-custom-router-api-key

# Rate Limiting (per unique API key or IP address)
# Default: 60 requests/minute with burst of 10 requests/second
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# Key Cooldown Durations (seconds)
COOLDOWN_RATE_LIMIT_SECS=60    # cooldown on HTTP 429 (rate limited by provider)
COOLDOWN_NETWORK_ERROR_SECS=15 # cooldown on 5xx / network errors
